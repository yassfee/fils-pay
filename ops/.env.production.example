# Template for the hosted box. Copy to ops/.env.local ON THE BOX and fill each value with
# `openssl rand -base64 32`. Never commit real values (ops/.env.local is gitignored).
NODE_ENV=production
PORT=3000
WEBHOOK_SECRET_ENCRYPTION_KEY=
SETTLEMENT_INTERNAL_TOKEN=
# Fresh value: the one once committed in ops/.env.docker is burned.
ACQUIRER_CALLBACK_SIGNING_SECRET=
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true
# Secure cookies need HTTPS in front of the api (TLS proxy or the provider's load balancer).
COOKIE_SECURE=true
# DEMO ONLY: there is no OTP delivery channel (the notifiers only log), so the login
# response carries the code. Remove once real delivery exists.
OTP_DEV_EXPOSE=true
CHECKOUT_BASE_URL=
# Demo determinism setting for the acquirer SIMULATOR (it randomly declines 2% of calls by default).
# The decline path stays proven by tests: processRefund.test.ts:326 (402 refund_declined, nothing written).
ACQUIRER_FAILURE_RATE=0
# Seed logins for the hosted box: `openssl rand -base64 24` each. The dev seed passwords in db/seed/generate.ts are
# public, and an EMPTY value falls back to them, so never leave these blank. smoke.sh logging in with
# PASSWORD=<SEED_USER_PASSWORD> proves the override took effect. Never keep the seed's output (it prints API keys).
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=
